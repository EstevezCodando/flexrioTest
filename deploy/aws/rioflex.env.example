# Variáveis do contêiner do Rio Flex na AWS. Copie para rioflex.env (fica fora do git) para customizar.
# Sem chaves AWS aqui: na instância, o SDK usa a role dela (a mesma que invoca a FlexIA no AgentCore).
NODE_ENV=production
# FlexIA da AWS (AgentCore). O implantar.py acrescenta FLEXIA_RUNTIME_ARN e AWS_REGION a partir do .env da FlexIA.
FLEXIA_BACKEND=agentcore
FLEXIA_TIMEOUT_MS=90000
# Demonstração ao vivo: habilita as contas de demonstração (senhas do README). Para uso real, defina
# SEED_CONSUMER_PASSWORD e SEED_MANAGER_PASSWORD e remova esta linha.
DEMO_ACCOUNTS=true
# Acesso direto por HTTP (IP da instância) ou túnel SSM: cookie sem flag Secure e sem proxy na frente.
# Atrás de HTTPS (ALB/CloudFront), use COOKIE_SECURE=true e TRUST_PROXY=1.
COOKIE_SECURE=false
TRUST_PROXY=0
CHARGING_SIM_SPEED=30
LOG_LEVEL=info
