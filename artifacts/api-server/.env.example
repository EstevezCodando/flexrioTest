# Porta do servidor da API
PORT=5000
# Arquivo SQLite persistente (criado automaticamente)
DB_PATH=./data/rioflex.db
# Origem permitida do frontend (CORS/CSRF). Separe múltiplas por vírgula.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Duração da sessão em horas
SESSION_TTL_HOURS=12
# true em produção (HTTPS) para cookies Secure
COOKIE_SECURE=false
# Aceleração da simulação de recarga (1 = tempo real; 30 = 1 s real = 30 s simulados)
CHARGING_SIM_SPEED=30

# FlexIA — opcional. Sem chave, a FlexIA usa o motor local baseado em regras.
ANTHROPIC_API_KEY=
FLEXIA_MODEL=claude-opus-5

# Credenciais de demonstração criadas no seed (somente ambiente local)
SEED_CONSUMER_EMAIL=marcos@rioflex.dev
SEED_CONSUMER_PASSWORD=RioFlex@2026
SEED_MANAGER_EMAIL=gestora@rioflex.dev
SEED_MANAGER_PASSWORD=Gestor@2026
