{
  "name": "@workspace/api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/cli.ts seed",
    "db:reset": "tsx --env-file-if-exists=.env src/db/cli.ts reset",
    "db:backup": "tsx --env-file-if-exists=.env src/db/cli.ts backup",
    "test": "tsx --test test/api.test.ts test/flexia.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "flexia:check": "tsx --env-file-if-exists=.env src/flexia/check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1140.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  }
}
